# PostgreSQL connection string used only by the Go backend.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Exact frontend origins allowed to send credentialed requests, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# Local defaults. In production with different frontend/backend sites, use true/None.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

PORT=8080

# Used only by: go run ./cmd/create-admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
